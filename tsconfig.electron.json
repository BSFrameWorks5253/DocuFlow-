  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "sourceMap": false,
    "outDir": "./electron-dist",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false
  },
  "include": ["electron/**/*"]
}
